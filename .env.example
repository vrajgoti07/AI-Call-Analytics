# ============================================================
# AI Call Analytics — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=ai-call-analytics
APP_ENV=development
DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---- Database (PostgreSQL + pgvector) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_call_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/ai_call_analytics

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- JWT Authentication ----
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ---- S3-Compatible Storage ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=call-recordings
STORAGE_REGION=us-east-1

# ---- AI / Model Configuration ----
WHISPER_MODEL_SIZE=base
DEVICE=cpu
HF_HOME=./models/huggingface
HUGGINGFACE_TOKEN=your-huggingface-token-here  # Placeholder: supply real token after accepting terms (e.g. pyannote)

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
